DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="generate-a-long-random-string"

WS_INTERNAL_SECRET="generate-a-long-random-string"
WS_INTERNAL_URL="http://localhost:4001"
NEXT_PUBLIC_WS_URL="http://localhost:4001"

# Production: Cloudflare R2 (STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com,
# STORAGE_REGION=auto, omit STORAGE_FORCE_PATH_STYLE).
# Local dev: any S3-compatible server, e.g. MinIO on localhost:9000.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="wamock-media"
STORAGE_FORCE_PATH_STYLE="true"
